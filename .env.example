APP_NAME=Job Portal API
BACKEND_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DATABASE_URL=postgresql+psycopg://llh@localhost:5432/job_portal
TEST_DATABASE_URL=postgresql+psycopg://llh@localhost:5432/job_portal_test
AUTH_SECRET_KEY=replace-with-a-long-random-secret
AUTH_REFRESH_SECRET_KEY=replace-with-a-long-random-refresh-secret
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_VERIFICATION_EXPIRE_MINUTES=10
EMAIL_VERIFICATION_RESEND_SECONDS=60
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_CODE=
SMTP_SENDER_EMAIL=
SMTP_USE_TLS=true
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_SECONDS=60
LLM_STREAM_READ_TIMEOUT_SECONDS=300
LLM_THINKING=false
LLM_USE_RESPONSE_FORMAT=true
LLM_STRUCTURED_MAX_RETRIES=2
UPLOAD_DIR=storage
MATCH_SCORE_THRESHOLD=0.73
DAILY_REWRITE_LIMIT=10
MAX_RESUME_UPLOAD_BYTES=3145728
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ARBEITNOW_API_URL=https://www.arbeitnow.com/api/job-board-api
QUEUE_WORKER_CONCURRENCY=1
QUEUE_POLL_INTERVAL_SECONDS=2
QUEUE_STALE_AFTER_SECONDS=900
QUEUE_WORKER_HEARTBEAT_TIMEOUT_SECONDS=15
QUEUE_MAX_ATTEMPTS=3
